TICKET_GROUP_IDS=
# Exact Cyrillic names. All three required.
TICKET_SURNAME=
TICKET_GIVEN_NAME=
TICKET_PATRONYMIC=
# Exact Latin spelling from passport; both optional together.
TICKET_LATIN_SURNAME=
TICKET_LATIN_GIVEN_NAME=
# Complete series+number. Multiple documents separated by semicolon.
TICKET_PASSPORTS=
